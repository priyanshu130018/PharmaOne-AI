# Keep build contexts small and never ship secrets or local artifacts.

# ---- VCS ----
.git
.gitignore

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# ---- Node / frontend ----
node_modules/
dist/
build/
.vite/

# ---- Local databases / temp uploads ----
*.sqlite
*.sqlite3
*.db
uploads/
tmp/
temp/

# ---- Logs ----
*.log
logs/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Docs / meta not needed in images ----
README.md
docker-compose.yml
