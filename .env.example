# ==============================================================================
# PharmaOne-AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the repository root:
#    cp .env.example .env
# 2. Fill in your existing Supabase project credentials below.
#    NEVER commit real credentials to version control.
# 3. Supply your AI API keys (GROQ_API_KEY, HUGGINGFACE_API_KEY) if live AI
#    generation / OCR features are required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment (Required)
# ------------------------------------------------------------------------------
# Options: production | staging | test
ENVIRONMENT=production

# Internal port the FastAPI backend server binds to (default: 8000)
BACKEND_PORT=8000

# Port the React frontend is served on (default: 8080)
FRONTEND_PORT=8080

# Public base URL of the backend API (used for OpenAPI docs metadata)
API_BASE_URL=http://localhost:8000

# Comma-separated list of allowed browser origins for CORS.
# Must include the origin where the frontend is loaded (http://localhost:8080).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Supabase Database Configuration (Required)
# ------------------------------------------------------------------------------
# PharmaOne-AI connects directly to your existing Supabase PostgreSQL database.
# Note: Always use the async PostgreSQL driver: postgresql+asyncpg://
# Format: postgresql+asyncpg://[user]:[password]@[host]:5432/[database]
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. Supabase Auth & Storage (Required)
# ------------------------------------------------------------------------------
# Supabase project URL and service role key for authentication and storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 4. AI Providers (LLM & Embeddings)
# ------------------------------------------------------------------------------
# Groq Cloud API for AI Investigation suggestions, 5 Whys, and CAPA drafting:
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
GROQ_MODEL=openai/gpt-oss-20b

# HuggingFace Inference API for document OCR and text embeddings:
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_placeholder

# ------------------------------------------------------------------------------
# 5. Document Upload & OCR Configuration
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (10MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# Enable OCR fallback via Hugging Face Inference API for scanned PDF/images
OCR_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Frontend Build Configuration
# ------------------------------------------------------------------------------
# API base URL reachable by the browser on the host machine:
VITE_API_BASE_URL=http://localhost:8000/api/v1
