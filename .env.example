# PharmaOne AI - environment configuration EXAMPLE.
#
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# Values marked <REPLACE_ME> are placeholders - the application fails fast at
# startup if a required variable is missing or left as a placeholder secret.

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# One of: development | staging | production | test
ENVIRONMENT=development

# Port the FastAPI backend binds to (inside the container and on the host).
BACKEND_PORT=8000

# Port the frontend (nginx) is served on.
FRONTEND_PORT=8080

# Public base URL the API is reached at (used for docs/OpenAPI server metadata).
# On a cloud server this is typically https://your-domain/api/v1
API_BASE_URL=http://localhost:8000

# Comma-separated list of browser origins allowed by CORS.
# Include the origin the frontend is served from.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ------------------------------------------------------------------------------
# Database (Supabase Postgres) - use the async driver (postgresql+asyncpg://)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:<REPLACE_ME_DB_PASSWORD>@<REPLACE_ME_DB_HOST>:5432/postgres
SUPABASE_URL=https://<REPLACE_ME_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY>

# ------------------------------------------------------------------------------
# AI providers
# ------------------------------------------------------------------------------
GROQ_API_KEY=<REPLACE_ME_GROQ_API_KEY>
# Example Groq chat model identifier (change to the model you are entitled to).
GROQ_MODEL=llama-3.3-70b-versatile
HUGGINGFACE_API_KEY=<REPLACE_ME_HUGGINGFACE_API_KEY>

# ------------------------------------------------------------------------------
# Frontend build (optional)
# ------------------------------------------------------------------------------
# Leave empty to use the relative path /api/v1 (recommended - nginx proxies it).
# Set only for non-standard deployments where the API lives on another origin.
VITE_API_BASE_URL=
