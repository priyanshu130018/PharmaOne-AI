# Rendered by the official nginx image entrypoint at container start:
# every ${VAR} below is replaced (via envsubst) with the value of the matching
# environment variable. Only FRONTEND_PORT, BACKEND_HOST and BACKEND_PORT are
# defined for this container, so nginx's own runtime variables ($uri, $host, …)
# are left untouched. This keeps the backend host/port out of the built bundle
# and fully environment-driven at deploy time.

server {
    listen       ${FRONTEND_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Do not cache the HTML shell so new deployments are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Long-lived caching for fingerprinted static assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page-app fallback: unknown routes serve the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy: forward the API to the backend service. The original URI
    # (e.g. /api/v1/deviations) is preserved because proxy_pass has no path part.
    location /api/ {
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Local liveness endpoint used by the container HEALTHCHECK (not proxied).
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }
}
